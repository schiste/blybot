# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Environments
.venv/
venv/

# Real configuration never enters the repo — only the example does.
# (Deployed envs live under $HOME on Toolforge, but a local blybot.env
# in a working copy is one `git add -A` away from being committed.)
*.env
!.env.example

# Tooling caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Editors / OS
.idea/
.vscode/
.DS_Store

# Never commit local configuration or credentials.
# Real config lives in the Toolforge tool home at 0600 (spec section 12).
.env
.env.*
!.env.example
*.secret
credentials*

# Chau7 editor session scratch
.chau7/
